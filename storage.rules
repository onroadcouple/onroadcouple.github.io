rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public: product images and itinerary covers
    match /products/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /itinerary-covers/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Private: itinerary PDFs — only accessible via Cloud Functions signed URLs
    match /itinerary-pdfs/{file} {
      allow read: if false;
      allow write: if request.auth != null;
    }
    
    // Default: authenticated write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}