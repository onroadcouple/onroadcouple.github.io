# Razorpay Public Keys (Safe for Git)
VITE_RAZORPAY_KEY_ID=rzp_test_YourTestKeyPairId

# Razorpay Secret Key (NEVER commit the actual secret!)
# This is used by the Vite dev server for local testing.
RAZORPAY_KEY_SECRET=YourRazorpaySecretKey

# Note: In production, the Secret Key is set in Firebase Cloud Functions 
# using: firebase functions:config:set razorpay.key_secret="your_secret"
