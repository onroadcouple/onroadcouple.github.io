rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Itinerary Products
    match /itinerary-products/{productId} {
      allow read: if true; // Publicly readable
      allow write: if isAuthenticated(); // Only admin can create/edit/delete
    }

    // Amazon Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if isAuthenticated(); // Only admin can see and manage orders
    }
  }
}